---
// FE-44 — the newest `now` entry, dated.
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Prose from '@/components/Prose.astro';
import { formatDate, isoDate } from '@/lib/dates';

const entries = (await getCollection('now')).sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime());
const latest = entries[0];
if (!latest) throw new Error('src/content/now/ has no entries');
const { Content } = await render(latest);
---

<Base title="Now" description={`What Michael Johnson is doing now, updated ${formatDate(latest.data.updated)}.`}>
  <h1>Now</h1>
  <p class="meta">
    <span class="k">updated=</span><time datetime={isoDate(latest.data.updated)}>{formatDate(latest.data.updated)}</time>
  </p>
  <Prose><Content /></Prose>
  <p class="what">
    A <a href="https://nownownow.com/about" rel="noopener">now page</a> says what I'm focused on at this point in my life.
  </p>
</Base>

<style>
  .meta {
    margin-bottom: var(--space-6);
  }
  .what {
    margin-top: var(--space-8);
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }
</style>
