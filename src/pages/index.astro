---
// FE-40 — the thirty-second path.
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Timeline from '@/components/resume/Timeline.astro';
import PostCard from '@/components/PostCard.astro';
import { getSelectedPosts } from '@/lib/posts';
import { personJsonLd, resume, yearsOfExperience } from '@/lib/resume';

const posts = await getSelectedPosts();
const site = (Astro.site ?? new URL('https://mika-net.io')).origin;
const years = yearsOfExperience();
---

<Base
  title="Home"
  description={`${resume.basics.label} with ${years}+ years building cloud-first, event-driven systems on AWS and .NET, and leading the teams that run them. Writing under Lessons Distilled.`}
  type="profile"
  jsonLd={personJsonLd(site)}
>
  <Hero />

  <section class="career" aria-labelledby="career-h">
    <h2 id="career-h"><a href="/resume/">{years}+ years, one line</a></h2>
    <Timeline compact />
  </section>

  <section aria-labelledby="writing-h">
    <h2 id="writing-h">Selected writing</h2>
    <p class="meta">imprint=lessons distilled  tagline=lessons learned from building things</p>
    <div class="list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    <p class="more"><a href="/posts/">All posts</a></p>
  </section>
</Base>

<style>
  .career h2 {
    font-size: var(--text-lg);
    margin-top: var(--space-12);
    margin-bottom: 0;
  }
  .career h2 a {
    text-decoration: none;
    color: var(--fg-muted);
  }
  .career h2 a:hover {
    color: var(--accent);
  }
  section h2 + .meta {
    margin-bottom: var(--space-4);
  }
  .list {
    margin-top: var(--space-2);
  }
  .more {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
